# Copy to .env. Never commit a filled .env.

# Local Postgres (docker compose). These defaults are for localhost only.
POSTGRES_DB=temporal
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
DATABASE_URL=postgresql+psycopg://temporal:temporal@localhost:5432/temporal

# Optional public-data tokens. Leave blank to call without one.
PERMITS_API_URL=
SOCRATA_APP_TOKEN=
SOCRATA_HOST=data.sf.gov
SOCRATA_API_VERSION=v2

# Browser Maps key. Restrict it to your hosts in Google Cloud (HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=

# Optional Vertex fusion. Off unless both GRAPH_AI and VERTEX_PROJECT are set.
GRAPH_AI=false
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=
